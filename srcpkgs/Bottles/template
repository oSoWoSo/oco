# Multilib/umu-launcher are only available on glibc x86_64.
case "$XBPS_TARGET_MACHINE" in
	x86_64)
		depends+=" libunwind-32bit freetype-32bit fontconfig-32bit umu-launcher"
		;;
esac

post_patch() {
	# ODY-166: The sandbox gate patch has already broken window.py once
	# (orphaned parentheses -> IndentationError) and ended up in the repo because
	# Meson doesn't compile .py files. Here, the build fails immediately if a patch
	# leaves the source code in a state where it cannot be compiled.
	python3 -m compileall -q bottles/frontend >/dev/null
}
