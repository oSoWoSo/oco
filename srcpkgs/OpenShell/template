# Template file for 'OpenShell'
pkgname=OpenShell
version=0.1.3
revision=1
build_style=cargo
# Opening /proc/<tid>/mem for writing fails with EROFS
make_check_args="-- --skip proc_mem_fallback_reads_and_writes_exact_memory"
hostmakedepends="pkg-config"
makedepends="libzstd-devel sqlite-devel z3-devel"
checkdepends="git e2fsprogs"
short_desc="OpenShell is the safe, private runtime for autonomous AI agents"
maintainer="zenobit <zen@osowoso.org>"
license="Apache-2.0"
homepage="https://github.com/NVIDIA/OpenShell"
distfiles="https://github.com/NVIDIA/OpenShell/archive/refs/tags/v${version}.tar.gz"
checksum=a49805055160ec19672542e91ae2432d2850dd5756bd113cbe51d38eaf24c180

do_build() {
	cargo build --release -p openshell-gateway --no-default-features --features defaults-without-telemetry
	cargo build --release -p openshell-sandbox
	cargo build --release -p openshell-driver-vm --no-default-features --features defaults-without-telemetry
}

pre_check() {
	# oci_workspace tests use /tmp and require it to be world traversable
	chmod 1777 /tmp
}

do_install() {
	local -a _args=(install --target "${RUST_TARGET}" --root "${DESTDIR}/usr" --offline --locked)
	cargo "${_args[@]}" --path crates/openshell-gateway --no-default-features --features defaults-without-telemetry
	cargo "${_args[@]}" --path crates/openshell-sandbox
	cargo "${_args[@]}" --path crates/openshell-driver-vm --no-default-features --features defaults-without-telemetry
}
