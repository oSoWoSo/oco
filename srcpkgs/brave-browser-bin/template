		vmove opt/brave/libqt6_shim.so
	}
}

brave-origin-bin-qt5_package() {
	short_desc+=" - Qt5 integration shim"
	pkg_install() {
		vmove opt/brave-origin/libqt5_shim.so
	}
}

brave-origin-bin-qt6_package() {
	short_desc+=" - Qt6 integration shim"
	pkg_install() {
		vmove opt/brave-origin/libqt6_shim.so
	}
}
