# Template file for 'brave-browser-bin'
pkgname=brave-browser-bin
version=1.100.59
revision=1
archs="x86_64 aarch64"
depends="desktop-file-utils hicolor-icon-theme hwids xdg-utils"
short_desc="One of the most private browsers built on top off Chromium project"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://www.brave.com/"
changelog="https://raw.githubusercontent.com/brave/brave-browser/refs/heads/master/CHANGELOG_DESKTOP.md"
case "$XBPS_TARGET_MACHINE" in
	x86_64)
		distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser_${version}_amd64.deb
		 https://github.com/brave/brave-browser/releases/download/v${version}/brave-origin_${version}_amd64.deb"
		checksum="eff29257c56974a79d74aa8c168d5062557da36c0c82c8c2412de70fdcb17861
		 ce38a50afc3449ae9c305100608c6abab1a30c85f751915187bd7c634b2b736f"
		;;
	aarch64)
		distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser_${version}_arm64.deb
		 https://github.com/brave/brave-browser/releases/download/v${version}/brave-origin_${version}_arm64.deb"
		checksum="da7bb47083f53d4d1a32083bfaa0a34a68eb2e0bd6182cfd61e18cfc8c7b4f84
		 d2edf30577c6a68099a7cfa896eeb915eeaf163107f762fe25b78aed30ec3f9f"
		;;
esac
replaces="brave-browser-arm-bin>=0"
nostrip=yes
nopie=yes
noshlibprovides=yes

post_extract() {
	rm -rf etc opt/brave.com/brave/cron opt/brave.com/brave-origin/cron
}

do_install() {
	# Brave Browser
	vcopy usr /
	vcopy opt /
	for size in 16 24 32 48 64 128 256; do
		vinstall opt/brave.com/brave/product_logo_${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps brave-browser.png
	done
	vbin ${FILESDIR}/brave
	vlicense opt/brave.com/brave/LICENSE

	# Brave Origin
	for size in 16 24 32 48 64 128 256; do
		vinstall opt/brave.com/brave-origin/product_logo_${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps brave-origin.png
	done
	vbin ${FILESDIR}/brave-origin
}

brave-origin-bin_package() {
	short_desc+=" - minimalist version"
	depends="desktop-file-utils hicolor-icon-theme hwids xdg-utils"
	noshlibprovides=yes
	pkg_install() {
		vmove usr/bin/brave-origin-stable
		vmove usr/bin/brave-origin
		vmove opt/brave.com/brave-origin
		for size in 16 24 32 48 64 128 256; do
			vmove usr/share/icons/hicolor/${size}x${size}/apps/brave-origin.png
		done
		vmove usr/share/applications/brave-origin.desktop
		vmove usr/share/applications/com.brave.Origin.desktop
		vmove usr/share/appdata/brave-origin.appdata.xml
		vmove usr/share/gnome-control-center/default-apps/brave-origin.xml
		vmove "usr/share/man/man1/brave-origin*.1.gz"
		vmove usr/share/doc/brave-origin
		vmove usr/share/doc/brave-origin-stable
		vlicense opt/brave.com/brave-origin/LICENSE
	}
}

brave-browser-bin-qt5_package() {
	short_desc+=" - Qt5 integration"
	pkg_install() {
		vmove opt/brave.com/brave/libqt5_shim.so
	}
}

