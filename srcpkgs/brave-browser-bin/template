# Template file for 'brave-browser-bin'
pkgname=brave-browser-bin
version=1.98.60
revision=1
archs="x86_64 aarch64"
hostmakedepends="unzip"
depends="desktop-file-utils hicolor-icon-theme hwids xdg-utils"
short_desc="One of the most private browsers built on top off Chromium project"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://www.brave.com/"
changelog="https://raw.githubusercontent.com/brave/brave-browser/refs/heads/master/CHANGELOG_DESKTOP.md"
distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-linux-amd64.zip
 https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-linux-arm64.zip
 https://github.com/brave/brave-browser/releases/download/v${version}/brave-origin-${version}-linux-amd64.zip
 https://github.com/brave/brave-browser/releases/download/v${version}/brave-origin-${version}-linux-arm64.zip"
checksum="0e49b5f84597fbbefdc8d791900d170d4f3792dc5d38056f6a3e35100706cdc7
