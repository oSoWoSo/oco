From 16699b3b46deed2b91b6a88b2e3de3ba76bc344e Mon Sep 17 00:00:00 2001
From: Coolllyn <259352926+Coolllyn@users.noreply.github.com>
Date: Thu, 5 Nov 2026 09:51:11 +0700
Subject: [PATCH] test: inline extglob-disabled script into stdin (#1672)

---
 .../compat/patterns/filename_expansion.yaml   | 28 ++++++++-----------
 1 file changed, 12 insertions(+), 16 deletions(-)

diff --git a/brush-shell/tests/cases/compat/patterns/filename_expansion.yaml b/brush-shell/tests/cases/compat/patterns/filename_expansion.yaml
index d19f434e7..c2caead47 100644
--- a/brush-shell/tests/cases/compat/patterns/filename_expansion.yaml
+++ b/brush-shell/tests/cases/compat/patterns/filename_expansion.yaml
@@ -120,26 +120,22 @@ cases:
       - path: "abadac.txt"
       - path: "fabadac.txt"
       - path: "f.txt"
-      - path: "script.sh"
-        contents: |
-          echo !(a*)
-          echo "result: $?"
+    stdin: |
+      shopt -u extglob
+      echo !(a*)
+      echo "result: $?"
 
-          echo @(abc|abd).txt
-          echo "result: $?"
+      echo @(abc|abd).txt
+      echo "result: $?"
 
-          echo ab?(c).txt
-          echo "result: $?"
+      echo ab?(c).txt
+      echo "result: $?"
 
-          echo *(ab|ad|ac).txt
-          echo "result: $?"
+      echo *(ab|ad|ac).txt
+      echo "result: $?"
 
-          echo f+(ab|ad|ac).txt
-          echo "result: $?"
-    stdin: |
-      shopt -u extglob
-      chmod +x ./script.sh
-      ./script.sh
+      echo f+(ab|ad|ac).txt
+      echo "result: $?"
 
   - name: "Pathname expansion: Inverted patterns"
     ignore_stderr: true
