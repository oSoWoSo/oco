# Template file for 'bun'
pkgname=bun
version=1.4.4
revision=1
archs="aarch64* x86_64*"
hostmakedepends="bun-bootstrap cargo clang23 llvm23 lld23 rustup cmake ninja
 pkg-config perl python3 tar unzip git nasm"
makedepends="llvm23-devel compiler-rt23"
checkdepends="procps-ng"
short_desc="JavaScript runtime, bundler, transpiler, and package manager"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://bun.sh"
distfiles="https://github.com/oven-sh/bun/archive/refs/tags/bun-v${version}.tar.gz"
checksum=00ce37fa5ac393a7d225bcf847365982fceb818b56a19b6884fefd67918468ff
nopie_files="/usr/bin/bun"
replaces="bun-bin>=0 bun-musl-bin>=0 bun-arm-bin>=0 bun-arm-musl-bin>=0"

do_patch() {
	export RUSTUP_HOME="${XBPS_BUILDDIR}/.rustup"
	export CARGO_HOME="${XBPS_BUILDDIR}/.cargo"
	export PATH="${CARGO_HOME}/bin:${RUSTUP_HOME}/bin:$PATH"
	RUSTUP_INIT_SKIP_PATH_CHECK=yes rustup-init -y --no-modify-path --default-toolchain none --profile minimal
	. "${CARGO_HOME}/env"
	rustup toolchain install nightly-2026-07-20 --profile minimal
	rustup component add rust-src --toolchain nightly-2026-07-20

	# Initialize git repo in extracted source so bun can get GIT_SHA
	# The tarball doesn't have git history which breaks compile-time constants
	cd /builddir/bun-${version}
	git init -q
	git config user.email "build@voidlinux.org"
	git config user.name "Void Build"
	git add -A
	git commit -q -m "Initial commit for build"
}

pre_configure() {
	# Bun's scripts/build/config.ts detectLinuxAbi() resolves the ABI from
	# /etc/alpine-release and defaults to "gnu" when it is missing. The Void
	# musl chroot has no such file, which makes the build treat a native musl
	# target as a gnu host cross-compiling to musl, skipping the musl-only
	# code paths (compat/queue for lshpack/lsquic) and demanding an Alpine
	# musl sysroot. A marker makes the native musl build take the musl path.
	if [ "$XBPS_TARGET_MACHINE" = 'x86_64-musl' ] || [ "$XBPS_TARGET_MACHINE" = 'aarch64-musl' ]; then
		install -m 0644 /dev/null /etc/alpine-release
	fi
}

do_configure() {
	export RUSTUP_HOME="${XBPS_BUILDDIR}/.rustup"
	export CARGO_HOME="${XBPS_BUILDDIR}/.cargo"
	export PATH="${CARGO_HOME}/bin:${RUSTUP_HOME}/bin:/usr/lib/llvm/21/bin:$PATH"
	bun scripts/build.ts --profile=release --configure-only
}

do_build() {
	export RUSTUP_HOME="${XBPS_BUILDDIR}/.rustup"
	export CARGO_HOME="${XBPS_BUILDDIR}/.cargo"
	export PATH="${CARGO_HOME}/bin:${RUSTUP_HOME}/bin:/usr/lib/llvm/21/bin:$PATH"
	ninja -C build/release
}

post_build() {
	# The alpine-release marker must not leak into the shared masterdir:
	# other packages built in the same job might read it and misreport
	# their distro as Alpine.
	if [ "$XBPS_TARGET_MACHINE" = 'x86_64-musl' ] || [ "$XBPS_TARGET_MACHINE" = 'aarch64-musl' ]; then
		rm -f /etc/alpine-release
	fi
}

do_check() {
	export RUSTUP_HOME="${XBPS_BUILDDIR}/.rustup"
	export CARGO_HOME="${XBPS_BUILDDIR}/.cargo"
	export PATH="${CARGO_HOME}/bin:${RUSTUP_HOME}/bin:/usr/lib/llvm/21/bin:$PATH"
	ninja -C build/release check
}

do_install() {
	vbin build/release/bun-profile
	mv ${DESTDIR}/usr/bin/bun-profile ${DESTDIR}/usr/bin/bun
	vlicense LICENSE.md
	vdoc README.md
}
