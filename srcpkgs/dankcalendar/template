# Template file for 'dankcalendar'
pkgname=dankcalendar
version=2.0.0
revision=1
build_style=go
build_helper=qemu
build_wrksrc="core"
go_import_path="github.com/AvengeMedia/dankcalendar/core"
go_package="${go_import_path}/cmd/dcal"
go_ldflags="-X main.Version=${version}"
depends="quickshell libsecret qt6-declarative"
short_desc="Calendar app for the Dank Linux desktop (Local, Google, CalDAV, iCloud)"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/AvengeMedia/dankcalendar"
changelog="https://github.com/AvengeMedia/dankcalendar/releases"
distfiles="https://github.com/AvengeMedia/dankcalendar/archive/refs/tags/v${version}.tar.gz"
checksum=866ee8dfedb91639c8d13081cb52ff743eaeeb322545f67ff74f74eb85674cdb

post_install() {
	vmkdir usr/share/quickshell/dankcal
	for q in ../quickshell/*; do
		vcopy "$q" usr/share/quickshell/dankcal
	done
	vinstall ../assets/com.danklinux.dankcalendar.desktop 644 usr/share/applications
	vinstall ../quickshell/assets/dankcalendar-tray.svg 644 usr/share/icons/hicolor/scalable/apps
	vlicense ../LICENSE
	for shell in bash zsh fish; do
		vtargetrun $DESTDIR/usr/bin/dcal completion ${shell} > dcal.${shell}
		vcompletion dcal.${shell} ${shell}
	done
}
