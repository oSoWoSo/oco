# Template file for 'dux-shell'
pkgname=dux-shell
version=2.0.0
revision=1
build_style=go
build_helper=qemu
build_wrksrc="core"
go_import_path="github.com/duxlabs-dev/dux-shell/core"
go_package="${go_import_path}/cmd/dms"
go_build_tags="distro_binary"
go_ldflags="-X main.Version=${version}"
hostmakedepends="make tar"
depends="quickshell accountsservice dux-gop matugen dbus elogind mesa-dri"
short_desc="Dux Shell — Material 3 desktop shell for Wayland"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://duxlabs.dev"
changelog="https://github.com/duxlabs-dev/dux-shell/releases"
distfiles="https://github.com/duxlabs-dev/dux-shell/archive/refs/tags/v${version}.tar.gz>dux-shell.tar.gz
 https://github.com/duxlabs-dev/dux-qml-common/archive/refs/tags/v${version}.tar.gz>dux-qml-common.tar.gz"
checksum="e81b0b496b3a6a5a08a6b045ef04d79b3a36f9b07bbfdf475e7dceb80228aca4
 dc08721f6df0fbd7717486e1fd3aa29e0b6ec0c687c68efd6b4576751b0752ca"
replaces="DankMaterialShell>=0"

post_extract() {
	cp -r dux-shell-${version}/* ./
	cp -r dux-qml-common-${version} dux-qml-common/
}

post_install() {
	cd ..
	vinstall assets/dms-open.desktop 644 usr/share/applications
	vinstall assets/dev.duxlabs.shell.desktop 644 usr/share/applications
	vinstall assets/dev.duxlabs.shell.notepad.desktop 644 usr/share/applications
	vinstall assets/dev.duxlabs.shell.svg 644 usr/share/icons/hicolor/scalable/apps

	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/dms completion ${shell} > ${pkgname}.${shell}
		vcompletion ${pkgname}.${shell} ${shell}
	done

	vlicense LICENSE
}

DankMaterialShell_package() {
	metapackage=yes
	short_desc="Renamed to dux-shell (transitional dummy package)"
	depends="${sourcepkg}>=${version}_${revision}"
	reverts="1.6.1"
}
