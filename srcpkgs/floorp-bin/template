# Template file for 'floorp-bin'
pkgname=floorp-bin
version=12.20.2
revision=1
archs="x86_64 aarch64"
short_desc="Browser built for keeping the Open, Private and Sustainable Web alive"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://github.com/Floorp-Projects/Floorp"
distfiles="https://github.com/Floorp-Projects/Floorp/releases/download/v${version}/floorp-linux-aarch64.tar.xz
 https://github.com/Floorp-Projects/Floorp/releases/download/v${version}/floorp-linux-x86_64.tar.xz"
checksum="3521183a928c7e2a43577e1cccb9fc70c71c90ed7538221e1f4435e051d00d22
 059a85f0e40c9f3649ae61fe716ecbdde85f06971a600aeec5c3e8f3a0af6004"

do_extract() {
	vextract "${XBPS_SRCDISTDIR}/${pkgname}-${version}/floorp-linux-${XBPS_TARGET_MACHINE}.tar.xz"
}

do_install() {
	vbin "${FILESDIR}/floorp"
	vmkdir usr/lib/floorp
	vcopy * usr/lib/floorp
	vinstall "${FILESDIR}/floorp.desktop" 644 usr/share/applications
	for size in 16 32 48 64 128; do
		vinstall browser/chrome/icons/default/default${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps floorp.png
	done
}
