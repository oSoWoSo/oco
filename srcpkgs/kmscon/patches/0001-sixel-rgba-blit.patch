 	bool visible;
 };
 
+/* A single sixel/raster-image placement, in cell coordinates, handed to
+ * the active text-renderer backend for blitting. Mirrors struct
+ * tsm_screen_image but is kept as a separate type so text.h doesn't need
+ * to depend on libtsm.h beyond what it already pulls in via tsm_screen. */
+struct kmscon_image {
+	unsigned int cell_x;
+	unsigned int cell_y;
+	unsigned int pixel_width;
+	unsigned int pixel_height;
+	const uint8_t *rgba;
+};
+
 struct kmscon_text_ops {
 	const char *name;
 	struct shl_module *owner;
@@ -88,6 +100,13 @@ struct kmscon_text_ops {
 	int (*prepare)(struct kmscon_text *txt, struct tsm_screen_attr *attr);
 	int (*draw)(struct kmscon_text *txt, const struct tsm_screen_cell *cells,
 		    struct kmscon_cursor *cursor);
+	/*
+	 * Optional. Blit a single decoded raster image (currently: a
+	 * sixel graphic) at the given cell position. Backends that don't
+	 * support this (e.g. the GL text renderer, for now) leave this
+	 * NULL; callers must check before calling.
+	 */
+	int (*draw_image)(struct kmscon_text *txt, const struct kmscon_image *image);
 	int (*draw_pointer)(struct kmscon_text *txt, unsigned int x, unsigned int y);
 	int (*render)(struct kmscon_text *txt);
 	void (*abort)(struct kmscon_text *txt);
@@ -118,6 +137,14 @@ int kmscon_text_rotate(struct kmscon_text *txt, enum Orientation orientation);
 
 int kmscon_text_prepare(struct kmscon_text *txt, struct tsm_screen_attr *attr, bool blinking);
 int kmscon_text_draw(struct kmscon_text *txt, struct tsm_screen *con, bool cursor_blink);
+/*
+ * Blit every raster image currently placed on `con` (per
+ * tsm_screen_images_draw()) using the active backend's draw_image op.
+ * Silently does nothing if the backend doesn't implement draw_image.
+ * Call this after kmscon_text_draw() and before kmscon_text_render(),
+ * once per repaint, so images stay visible across redraws.
+ */
+int kmscon_text_draw_images(struct kmscon_text *txt, struct tsm_screen *con);
 int kmscon_text_draw_pointer(struct kmscon_text *txt, unsigned int x, unsigned int y);
 int kmscon_text_render(struct kmscon_text *txt);
 void kmscon_text_abort(struct kmscon_text *txt);
