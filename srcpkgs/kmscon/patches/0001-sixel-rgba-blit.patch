diff --git a/src/video/drm2d_render.c b/src/video/drm2d_render.c
index 4a0e35e..550ed5a 100644
--- a/src/video/drm2d_render.c
+++ b/src/video/drm2d_render.c
@@ -117,6 +117,79 @@ int drm2d_display_blend(struct display *disp, const struct video_blend_req *req)
 	return 0;
 }
 
+/*
+ * Alpha-composite a full-color RGBA source (e.g. a decoded sixel image)
+ * directly onto the back buffer. Unlike drm2d_display_blend(), the
+ * source already carries per-pixel RGB, not just an alpha mask against
+ * a fixed ink color, so no fr/fg/fb/br/bg/bb parameters are involved.
+ */
+int drm2d_display_blit_rgba(struct display *disp, const struct video_rgba_blit_req *req)
+{
+	unsigned int tmp;
+	uint8_t *dst;
+	const uint8_t *src;
+	unsigned int width, height, i;
+	unsigned int sw, sh;
+	struct drm2d_rb *rb;
+	struct drm2d_display *d2d = disp->data;
+
+	if (!req || !req->rgba)
+		return -EINVAL;
+
+	rb = &d2d->rb[d2d->current_rb ^ 1];
+	sw = disp->width;
+	sh = disp->height;
+
+	width = min(req->width, sw - min(req->x, sw));
+	tmp = req->x + width;
+	if (req->x >= sw)
+		return -EINVAL;
+	if (tmp > sw)
+		width = sw - req->x;
+
+	height = min(req->height, sh - min(req->y, sh));
+	tmp = req->y + height;
+	if (req->y >= sh)
+		return -EINVAL;
+	if (tmp > sh)
+		height = sh - req->y;
+
+	dst = rb->map;
+	dst = &dst[req->y * rb->stride + req->x * 4];
+	src = req->rgba;
+
+	while (height--) {
+		for (i = 0; i < width; ++i) {
+			const uint8_t *p = &src[i * 4];
+			uint8_t a = p[3];
+			uint32_t out;
+
+			if (a == 0) {
+				/* fully transparent: leave background untouched */
+			} else if (a == 255) {
+				out = ((uint32_t)p[0] << 16) | ((uint32_t)p[1] << 8) | p[2];
+				((uint32_t *)dst)[i] = out;
+			} else {
+				uint32_t old = ((uint32_t *)dst)[i];
+				unsigned int br = (old >> 16) & 0xff;
+				unsigned int bg = (old >> 8) & 0xff;
+				unsigned int bb = old & 0xff;
+				unsigned int r = (p[0] * a + br * (255 - a) + 0x80);
+				unsigned int g = (p[1] * a + bg * (255 - a) + 0x80);
+				unsigned int b = (p[2] * a + bb * (255 - a) + 0x80);
+
+				r = (r + (r >> 8)) >> 8;
+				g = (g + (g >> 8)) >> 8;
+				b = (b + (b >> 8)) >> 8;
+				((uint32_t *)dst)[i] = (r << 16) | (g << 8) | b;
+			}
+		}
+		dst += rb->stride;
+		src += req->width * 4;
+	}
+	return 0;
+}
