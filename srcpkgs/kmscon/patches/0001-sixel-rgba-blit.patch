diff --git a/src/render/bbulk.c b/src/render/bbulk.c
index c4649a4..a91d395 100644
--- a/src/render/bbulk.c
+++ b/src/render/bbulk.c
@@ -691,6 +691,75 @@ static int bbulk_prepare(struct kmscon_text *txt, struct tsm_screen_attr *attr)
 	return 0;
 }
 
+/*
+ * Blit a decoded sixel/raster image directly onto the display, bypassing
+ * the glyph-alpha-blend model entirely (display_blit_rgba composites a
+ * full-color source, unlike display_blend which only blends a single
+ * ink color through an alpha mask).
+ */
+static int bbulk_draw_image(struct kmscon_text *txt, const struct kmscon_image *image)
+{
+	struct video_rgba_blit_req req;
+	unsigned int x, y;
+
+	if (!image || !image->rgba)
+		return -EINVAL;
+
+	/*
+	 * set_coordinate() correctly handles all four screen orientations
+	 * for glyph-sized cells, but a sixel image is an axis-aligned
+	 * pixel rectangle that would need actual 90/270 degree image
+	 * rotation to render correctly when the display itself is
+	 * rotated. That rotation isn't implemented here -- we place the
+	 * image unrotated, which is correct for the common OR_NORMAL case
+	 * and merely mis-oriented (not crashing/corrupting) otherwise.
+	 */
+	set_coordinate(txt, &x, &y, image->cell_x, image->cell_y);
+
+	/*
+	 * Damage tracking is cell-based and is recomputed in bbulk_render()
+	 * from the per-cell flags, which bbulk_draw() sets only for cells
+	 * whose contents changed. An image covers cells whose text did not
+	 * change, so without this its rectangle would never reach
+	 * display_set_damage() and -- because DRM2D hands that set to the
+	 * controller as FB_DAMAGE_CLIPS -- the image would not appear on
+	 * displays with damage tracking enabled. Mark the covered cells and
+	 * let the existing damage pass turn them into rectangles.
+	 */
+	{
+		struct bbulk *bb = txt->data;
+		unsigned int fw = FONT_WIDTH(txt);
+		unsigned int fh = FONT_HEIGHT(txt);
+		unsigned int cols, rows, cx, cy;
+
+		cols = (image->pixel_width + fw - 1) / fw;
+		rows = (image->pixel_height + fh - 1) / fh;
+		if (cols == 0)
+			cols = 1;
+		if (rows == 0)
+			rows = 1;
+		if (cols > txt->cols - min(image->cell_x, txt->cols))
+			cols = txt->cols - min(image->cell_x, txt->cols);
+		if (rows > txt->rows - min(image->cell_y, txt->rows))
+			rows = txt->rows - min(image->cell_y, txt->rows);
+
+		for (cy = image->cell_y; cy < image->cell_y + rows && cy < txt->rows; ++cy) {
+			for (cx = image->cell_x;
+			     cx < image->cell_x + cols && cx < txt->cols; ++cx)
+				damage_cell(bb, cx + cy * txt->cols);
+		}
+	}
+
+	memset(&req, 0, sizeof(req));
+	req.rgba = image->rgba;
+	req.width = image->pixel_width;
+	req.height = image->pixel_height;
+	req.x = x;
+	req.y = y;
+
+	return display_blit_rgba(txt->disp, &req);
+}
+
 struct kmscon_text_ops kmscon_text_bbulk_ops = {
 	.name = "bbulk",
 	.owner = NULL,
@@ -702,6 +771,7 @@ struct kmscon_text_ops kmscon_text_bbulk_ops = {
 	.rotate = bbulk_rotate,
 	.prepare = bbulk_prepare,
