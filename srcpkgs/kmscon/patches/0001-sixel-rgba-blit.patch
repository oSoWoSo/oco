+/*
+ * Alpha-composite a full-color RGBA source (e.g. a decoded sixel image)
+ * onto the framebuffer. Full alpha blending is only done for the 32bpp
+ * (xrgb32) case, which matches every commonly-used mode today; for
+ * legacy 16/24bpp framebuffers we fall back to a simple >=50% alpha
+ * threshold rather than reading back and re-blending an already
+ * format-converted destination pixel.
+ */
+int fbdev_display_blit_rgba(struct display *disp, const struct video_rgba_blit_req *req)
+{
+	unsigned int tmp, width, height, i;
+	uint8_t *dst;
+	const uint8_t *src;
+	struct fbdev_display *fbdev = disp->data;
+
+	if (!req || !req->rgba)
+		return -EINVAL;
+
+	width = min(req->width, fbdev->xres - min(req->x, fbdev->xres));
+	tmp = req->x + width;
+	if (req->x >= fbdev->xres)
+		return -EINVAL;
+	if (tmp > fbdev->xres)
+		width = fbdev->xres - req->x;
+
+	height = min(req->height, fbdev->yres - min(req->y, fbdev->yres));
+	tmp = req->y + height;
+	if (req->y >= fbdev->yres)
+		return -EINVAL;
+	if (tmp > fbdev->yres)
+		height = fbdev->yres - req->y;
+
+	if (!(disp->flags & DISPLAY_DBUF) || fbdev->bufid)
+		dst = fbdev->map;
+	else
+		dst = &fbdev->map[fbdev->yres * fbdev->stride];
+	dst = &dst[req->y * fbdev->stride + req->x * fbdev->Bpp];
+	src = req->rgba;
+
+	if (fbdev->xrgb32) {
+		while (height--) {
+			for (i = 0; i < width; ++i) {
+				const uint8_t *p = &src[i * 4];
+				uint8_t a = p[3];
+				uint32_t r, g, b, old;
+
+				if (a == 0)
+					continue;
+				if (a == 255) {
+					((uint32_t *)dst)[i] = ((uint32_t)p[0] << 16) |
+								((uint32_t)p[1] << 8) | p[2];
+					continue;
+				}
+				old = ((uint32_t *)dst)[i];
+				r = (p[0] * a + ((old >> 16) & 0xff) * (255 - a) + 0x80);
+				g = (p[1] * a + ((old >> 8) & 0xff) * (255 - a) + 0x80);
+				b = (p[2] * a + (old & 0xff) * (255 - a) + 0x80);
+				r = (r + (r >> 8)) >> 8;
+				g = (g + (g >> 8)) >> 8;
+				b = (b + (b >> 8)) >> 8;
+				((uint32_t *)dst)[i] = (r << 16) | (g << 8) | b;
+			}
+			dst += fbdev->stride;
+			src += req->width * 4;
+		}
+	} else {
+		while (height--) {
+			for (i = 0; i < width; ++i) {
+				const uint8_t *p = &src[i * 4];
+				uint32_t val;
+
+				if (p[3] < 128)
+					continue;
+				val = ((uint32_t)p[0] << 16) | ((uint32_t)p[1] << 8) | p[2];
+				if (fbdev->Bpp == 2)
+					((uint16_t *)dst)[i] = xrgb32_to_device(disp, val);
+				else if (fbdev->Bpp == 3)
+					write_24bit(&dst[i * 3], xrgb32_to_device(disp, val));
+				else if (fbdev->Bpp == 4)
+					((uint32_t *)dst)[i] = xrgb32_to_device(disp, val);
+			}
+			dst += fbdev->stride;
+			src += req->width * 4;
+		}
+	}
+
+	return 0;
+}
