diff --git a/src/render/text.c b/src/render/text.c
index 437c722..c3637ff 100644
--- a/src/render/text.c
+++ b/src/render/text.c
@@ -488,6 +488,58 @@ int kmscon_text_draw(struct kmscon_text *txt, struct tsm_screen *con, bool curso
 	return txt->ops->draw(txt, cells, &cursor);
 }
 
+struct draw_images_ctx {
+	struct kmscon_text *txt;
+	int ret;
+};
+
+static void draw_images_cb(struct tsm_screen *con, const struct tsm_screen_image *image,
+			    void *data)
+{
+	struct draw_images_ctx *ctx = data;
+	struct kmscon_image kimg;
+	int ret;
+
+	(void)con;
+
+	kimg.cell_x = image->cell_x;
+	kimg.cell_y = image->cell_y;
+	kimg.pixel_width = image->pixel_width;
+	kimg.pixel_height = image->pixel_height;
+	kimg.rgba = image->rgba;
+
+	ret = ctx->txt->ops->draw_image(ctx->txt, &kimg);
+	if (ret && !ctx->ret)
+		ctx->ret = ret;
+}
+
+/**
+ * kmscon_text_draw_images:
+ * @txt: valid text renderer
+ * @con: valid tsm screen
+ *
+ * Blits every currently-placed raster image (sixel graphics) onto the
+ * backend. No-op if the active backend has no draw_image implementation.
+ *
+ * Returns: 0 on success, negative error code from the first failed blit,
+ * or -EOPNOTSUPP if the backend can't draw images at all.
+ */
+int kmscon_text_draw_images(struct kmscon_text *txt, struct tsm_screen *con)
+{
+	struct draw_images_ctx ctx;
+
+	if (!txt || !con)
+		return -EINVAL;
+	if (!txt->ops->draw_image)
+		return -EOPNOTSUPP;
+
+	ctx.txt = txt;
+	ctx.ret = 0;
+	tsm_screen_images_draw(con, draw_images_cb, &ctx);
+
+	return ctx.ret;
+}
+
 /**
  * kmscon_text_draw_pointer:
  * @txt: valid text renderer
diff --git a/src/render/text.h b/src/render/text.h
