# Template file for 'luciole-git'
pkgname=luciole-git
version=0.1.0.20261121
revision=4
_commit=01a7828f6f38bf18b2c0588a1c830bbde1d3fcde
build_style=meson
configure_args="-Dbuild_revision=${_commit}"
make_check_args="--exclude=operation-activity --exclude=thumbnail --exclude=archive-service --print-errorlogs"
hostmakedepends="pkgconf wayland-devel"
makedepends="acl-devel cairo-devel fontconfig-devel freetype-devel
 gdk-pixbuf-devel harfbuzz-devel json-c++ libarchive-devel
 libcurl-devel libglib-devel libglvnd-devel liblzma-devel libpng-devel
 librsvg-devel libxkbcommon-devel libxml2-devel pango-devel stb
 tomlplusplus-devel wayland-devel wayland-protocols"
depends="gsettings-desktop-schemas hicolor-icon-theme"
checkdepends="7zip dbus ffmpeg ffmpegthumbnailer libwebp-devel poppler
 python3"
short_desc="Native Wayland file manager using Noctalia rendering and controls"
maintainer="Coolllyn <leanhduc673@gmail.com>"
license="MIT"
homepage="https://github.com/noctalia-dev/luciole"
distfiles="https://github.com/noctalia-dev/luciole/archive/${_commit}.tar.gz"
checksum="d5558cd419c8d46bdc958064cb97f963d1ea793866414c025906ec15033512ed"

# chroot HOME=/tmp collides with hardcoded /tmp paths in upstream tests
make_check_pre="env HOME=/tmp/luciole-check-home"

# librsvg 2.59.2 header triggers -Wexpansion-to-defined under -Wpedantic
CXXFLAGS+=" -Wno-error=expansion-to-defined"

# permission-service SIGSEGVs under musl.
if [ "$XBPS_TARGET_LIBC" = musl ]; then
	make_check_args+=" --exclude=permission-service"
fi

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -Dtests=enabled"
else
	configure_args+=" -Dtests=disabled"
fi

pre_check() {
	mkdir -p /tmp/luciole-check-home
}

post_install() {
	vlicense LICENSE
	vlicense lib/assets/fonts/tabler-icons-license.txt tabler-icons.LICENSE
}
