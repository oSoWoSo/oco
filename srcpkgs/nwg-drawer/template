# Template file for 'nwg-drawer'
pkgname=nwg-drawer
version=0.7.6
revision=1
build_style=go
go_import_path=github.com/nwg-piotr/nwg-drawer
hostmakedepends="pkg-config"
makedepends="cairo-devel gdk-pixbuf-devel gtk+3-devel pango-devel
 gtk-layer-shell-devel libgirepository-devel libglib-devel"
short_desc="Application drawer for wlroots-based Wayland compositors"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://nwg-piotr.github.io/nwg-shell/nwg-drawer"
#changelog=""
distfiles="https://github.com/nwg-piotr/nwg-drawer/archive/refs/tags/v${version}.tar.gz"
checksum=5fad5051bfea0bf786bbbd799d75d9cb76214572990dc23d6dcff7cb2e5f59ab

pre_build() {
	go mod download
	GOMODCACHE="${XBPS_BUILDDIR}/${pkgname}-${version}/_build-${pkgname}-xbps/pkg/mod"
	modzip="${GOMODCACHE}/cache/download/github.com/diamondburned/gotk4/pkg/@v/v0.4.1.zip"
	moddir="${GOMODCACHE}/github.com/diamondburned/gotk4/pkg@v0.4.1"
	if [ ! -d "${moddir}" ]; then
		unzip -q "${modzip}" -d "${GOMODCACHE}"
	fi
	chmod -R u+w "${moddir}"
	patch -N -p1 -d "${moddir}" < "${FILESDIR}/gotk4-pango.patch"
}

post_install() {
	vinstall drawer.css 644 usr/share/nwg-drawer
	vcopy desktop-directories usr/share/nwg-drawer
	vcopy img usr/share/nwg-drawer
	vdoc README.md
	vlicense LICENSE
}
