# Template file for 'pdfcraft'
pkgname=pdfcraft
version=0.21.1
revision=1
build_style=cargo
make_build_args="-p pdfcraft -p pdfcraft-cli"
hostmakedepends="pkg-config"
# makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="PDF reader and editor written by scratch in pure Rust"
maintainer="zenobit <zen@osowoso.org>"
license="Apache-2.0, MIT"
homepage="https://github.com/storytold/pdfcraft"
distfiles="https://github.com/storytold/pdfcraft/archive/refs/tags/v${version}.tar.gz
 https://ocrs-models.s3-accelerate.amazonaws.com/text-detection.onnx>text-detection.onnx
 https://ocrs-models.s3-accelerate.amazonaws.com/text-recognition.onnx>text-recognition.onnx
 https://creativecommons.org/licenses/by-sa/4.0/legalcode.txt>LICENSE-OCRS-MODELS"

checksum="d6cb5a437aa531fe3ae91250e2b6aa52cf4208cc521c17fc30aeccc917c0e9f5
 a917b23dbd9524b465df7e922641b3ff2981623df4ded5a0234004ef2fee7cfe
 86c145c2edb96c8caed5b1ebb8f44d706408922211451c309c625157dd6061c5
 28a9529c7d0bb4dc51f4bf5c116a3d16ef247a052f7591466768ddf563fd1cf5"

# Instruct XBPS-src to copy these files directly without attempting to uncompress them
skip_extraction="text-detection.onnx text-recognition.onnx LICENSE-OCRS-MODELS"

do_install() {
	# 1. Install application for Desktop and command line (CLI)
	vbin target/${RUST_TARGET}/release/pdfcraft
	vbin target/${RUST_TARGET}/release/pdfcraft-cli

	# 2. Install shortcut in menu (.desktop) and mime types
	vinstall packaging/linux/ai.storyteller.pdfcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.pdfcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.pdfcraft.xml
	vinstall packaging/linux/ai.storyteller.pdfcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.pdfcraft.metainfo.xml

	# 3. Iterate icons and install
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.pdfcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.pdfcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.pdfcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.pdfcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install pre-fetched ONNX OCR neural models securely into the package share structure
	vmkdir usr/share/pdfcraft/models
	vinstall ${XBPS_SRCDISTDIR}/${pkgname}-${version}/text-detection.onnx 644 usr/share/pdfcraft/models
	vinstall ${XBPS_SRCDISTDIR}/${pkgname}-${version}/text-recognition.onnx 644 usr/share/pdfcraft/models

	# 5. Install licenses and legal NOTICE
	vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE-OCRS-MODELS
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 6. Technical documentation in Markdown
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
