# Template file for 'quickbox-gtk4'
pkgname=quickbox-gtk4
version=1.3.10
revision=1
#archs="i686 x86_64"
depends="gtk4 python3-gobject quickemu"
short_desc="GTK4 UI for managing quickemu VMs"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/musqz/quickbox"
distfiles="https://github.com/musqz/quickbox/archive/refs/tags/v${version}.tar.gz"
checksum=10e77329e7ef4f81fbf05e141846e255d7bbb58f59f147efe59e140ecd00e679

do_install() {
	vbin quickbox
	vinstall quickbox.desktop 644 usr/share/applications
	vinstall icons/hicolor/scalable/apps/quickbox.svg 644 usr/share/icons/hicolor/scalable/apps

	vmkdir usr/share/quickbox/translations
	vcopy translations/*.json usr/share/quickbox/translations

	vmkdir usr/share/quickbox
	vcopy version usr/share/quickbox
}

post_install() {
	vlicense LICENSE
}
