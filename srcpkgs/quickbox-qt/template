# Template file for 'quickbox-qt'
pkgname=quickbox-qt
version=1.3.5
revision=1
#archs="i686 x86_64"
depends="python3-gobject python3-pyside6 rsync quickemu xdg-utils"
short_desc="QT6 UI for managing Quickemu VMs"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/musqz/quickbox-qt"
distfiles="https://github.com/musqz/quickbox-qt/archive/refs/tags/v${version}.tar.gz"
checksum=ca019c1516eb79d2c1f0dbaa15d66d3ea8f7241bcf388b3ecc8f8e1c8674f3a5
conflicts=quickbox-gtk4

do_install() {
	vbin quickbox
	vinstall packaging/quickbox.desktop 644 usr/share/applications
	vinstall version.txt 644 usr/share/quickbox-qt
	vinstall icons/hicolor/scalable/apps/quickbox.svg 644 usr/share/icons/hicolor/scalable/apps

	vmkdir usr/share/quickbox-qt/translations
	vcopy translations/*.json usr/share/quickbox-qt/translations
}

post_install() {
	vlicense LICENSE
}
