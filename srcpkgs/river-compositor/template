# Template file for 'river-compositor'
pkgname=river-compositor
version=0.5.2
revision=1
archs="~i686* ~armv6l* ~armv7l*"
build_style=zig-build
configure_args="$(vopt_if xwayland -Dxwayland) -Dpie"
hostmakedepends="pkg-config wayland-devel scdoc"
makedepends="wlroots0.20-devel libevdev-devel libinput-devel pixman-devel
 wayland-protocols libxkbcommon-devel wayland-devel"
depends="$(vopt_if xwayland xorg-server-xwayland)"
short_desc="Non-monolithic tiling Wayland compositor"
maintainer="LinuxNation <linuxnation@posteo.com>"
license="GPL-3.0-only"
homepage="https://codeberg.org/river/river"
changelog="https://codeberg.org/river/river/releases"
distfiles="https://codeberg.org/river/river/releases/download/v${version}/river-${version}.tar.gz"
checksum=b9361943a8ed9c0ed98163ce705e5ef8bdcf087383c04eea210dce5ec094fa13
replaces="river>=0"
nocross=yes
build_options="xwayland"
build_options_default="xwayland"
desc_option_xwayland="Enable Xwayland support"

# zig-build build style passes an empty --sysroot for native builds, which
# zig 0.16 treats as relative paths, breaking system library discovery.
do_build() {
	local zig_target zig_cpu

	if [ "$CROSS_BUILD" ]; then
		zig_target="${XBPS_CROSS_ZIG_TARGET}"
		zig_cpu="${XBPS_CROSS_ZIG_CPU}"
	else
		zig_target="${XBPS_ZIG_TARGET}"
		zig_cpu="${XBPS_ZIG_CPU}"
	fi
	local _sysroot _search_prefix
	if [ "$CROSS_BUILD" ]; then
		_sysroot="${XBPS_CROSS_BASE}"
		_search_prefix="${XBPS_CROSS_BASE}/usr"
	else
		_sysroot="/"
		_search_prefix="/usr"
	fi

	# zig 0.17 removed the --global-cache-dir build flag; the global cache
	# directory is now set via the ZIG_GLOBAL_CACHE_DIR environment variable.
	DESTDIR="zig-out" ZIG_GLOBAL_CACHE_DIR=/host/zig zig build \
		-j"${XBPS_MAKEJOBS}" \
		--sysroot "${_sysroot}" \
		--search-prefix "${_search_prefix}" \
		--prefix /usr \
		--libc xbps_zig_libc.txt \
		--release=safe \
		--verbose \
		-Dtarget="${zig_target}" -Dcpu="${zig_cpu}" \
		install \
		${configure_args}
}

post_install() {
	vinstall contrib/river.desktop 644 usr/share/wayland-sessions
}
