# Template file for 'sf-app-info'
pkgname=sf-app-info
version=6.31.0.1
revision=1
build_style=cmake
configure_args="-DSF6_HOST_TOOLING=/usr/lib/cmake"
hostmakedepends="gettext qt6-base qt6-tools sf-cmake-modules sf-doctools
 sf-settings sonic-namespace"
makedepends="sf-core-addons-devel sf-doctools-devel sf-internationalization-devel
 sf-settings-devel"
short_desc="Query info about installed applications and their associated file types"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-app-info"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-app-info/archive/refs/tags/${version}.tar.gz"
checksum=6a6292722f743392a83897ef076e617604104c3fc0f1fd84dea1adf52db7aca0

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# tests fail on CI
	ctest -E "ksycocatest|kapplicationtradertest|kservicetest|ksycocathreadtest|ksycoca_xdgdirstest"
}

sf-app-info-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
