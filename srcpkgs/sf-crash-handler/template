# Template file for 'sf-crash-handler'
pkgname=sf-crash-handler
version=6.31.0.1
revision=1
build_style=cmake
hostmakedepends="qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="sf-core-addons-devel"
short_desc="Graceful handling of application crashes"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-crash-handler"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-crash-handler/archive/refs/tags/${version}.tar.gz"
checksum=823e9d2d353737e7d17f9b64037cdd4661862b46849593a5a91849eb128bf814

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-crash-handler-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
