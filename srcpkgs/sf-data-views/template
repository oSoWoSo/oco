# Template file for 'sf-data-views'
pkgname=sf-data-views
version=6.31.0
revision=1
build_style=cmake
configure_args="-DBUILD_DESIGNERPLUGIN=ON -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="qt6-base-devel qt6-tools-devel"
short_desc="Item views extending the Qt model-view framework"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-data-views"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-data-views/archive/refs/tags/${version}.tar.gz"
checksum=dc320c492a8649f942b9a1768a0cef45dfe2bec8e0abc7aa79ff46ac8ddef816

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-data-views-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
		if [ -d "${PKGDESTDIR}/usr/lib/qt6/plugins/designer" ]; then
			vmove usr/lib/qt6/plugins/designer
		fi
	}
}
