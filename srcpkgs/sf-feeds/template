# Template file for 'sf-feeds'
pkgname=sf-feeds
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="sf-text-codec-devel"
short_desc="RSS/Atom parser library"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-feeds"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-feeds/archive/refs/tags/${version}.tar.gz"
checksum=ff56f827104d0c05f037f8b55123791c4c70fa65785dfcff7256f75a6bdde443

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-feeds-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
