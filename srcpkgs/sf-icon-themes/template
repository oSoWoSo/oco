	sonic_namespace_patch
}

sf-icon-themes-devel_package() {
	provides="kf6-kiconthemes-devel-${version}_${revision}"
	conflicts="kf6-kiconthemes-devel"
	replaces="kf6-kiconthemes-devel>=0"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel qt6-declarative-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
