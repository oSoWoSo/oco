hostmakedepends="gettext qt6-base qt6-declarative-host-tools qt6-tools
 sf-cmake-modules sf-settings sonic-namespace"
makedepends="qt6-base-private-devel qt6-svg-devel sf-archive-devel
 sf-color-scheme-devel sf-internationalization-devel sf-settings-ui-devel
 sf-silver-icons-library-devel sf-widgets-addons-devel"
