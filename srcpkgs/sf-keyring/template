# Template file for 'sf-keyring'
pkgname=sf-keyring
version=6.31.0
revision=1
build_style=cmake
configure_args="-DSF6_HOST_TOOLING=/usr/lib/cmake"
hostmakedepends="gettext pkg-config qt6-base qt6-tools sf-cmake-modules
 sf-doctools sf-settings sonic-namespace"
makedepends="gpgmepp-devel libgcrypt-devel libsecret-devel sf-color-scheme-devel
 sf-core-addons-devel sf-crash-handler-devel sf-dbus-devel sf-doctools-devel
 sf-notifications-devel sf-settings-devel sf-widgets-addons-devel
 sf-windowsystem-devel sonic-crypto-library-devel"
short_desc="Safe desktop-wide storage for passwords"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-keyring"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-keyring/archive/refs/tags/${version}.tar.gz"
checksum=cb14ce3aa35193377834f8ffae19f934cee2da619432e7a3b5e84c3e53cdec4b

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

# https://bugs.kde.org/show_bug.cgi?id=509680 / https://github.com/void-linux/void-packages/issues/57348
post_install() {
	rm ${DESTDIR}/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kwallet.service
}

sf-keyring-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
