# Template file for 'sf-logging'
pkgname=sf-logging
version=6.31.0
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib -DKDE_INSTALL_LIBDIR=lib -DBUILD_TESTING=ON"
hostmakedepends="qt6-base qt6-tools sf-cmake-modules"
makedepends="qt6-base-devel"
short_desc="System logging library for SonicDE"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-only OR LGPL-3.0-only"
homepage="https://github.com/Sonic-DE/sonic-frameworks-logging"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-logging/archive/refs/tags/${version}.tar.gz"
checksum=4c1e38abf4b9c1cca3f31c0f8c8a531e524776699025d519f28757e9f92e7b25

post_patch() {
	vsed -i -e '/^add_library(sonicloggingtestqtpluginsonic MODULE testqtpluginsonic.cpp)$/a target_compile_options(sonicloggingtestqtpluginsonic PRIVATE -UQT_NO_DEBUG)' autotests/CMakeLists.txt
}

do_check() {
	cd build
	ctest --output-on-failure
}

sf-logging-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
