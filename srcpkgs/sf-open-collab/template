# Template file for 'sf-open-collab'
pkgname=sf-open-collab
version=6.31.0.1
revision=1
build_style=cmake
hostmakedepends="doxygen qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="libstdc++-devel qt6-base-devel"
short_desc="Qt library implementing Open Collaboration Services API (SonicDE fork)"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-only OR LGPL-3.0-only"
homepage="https://github.com/Sonic-DE/sonic-frameworks-open-collab"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-open-collab/archive/refs/tags/${version}.tar.gz"
checksum=2501ddcfd0ed5a39fc34e7e42f10fd24c66aa2b7297969bca9b4c8f033baac66

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	ctest -E "providertest"
}

sf-open-collab-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
