# Template file for 'sf-package'
pkgname=sf-package
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="gettext qt6-base qt6-tools sf-cmake-modules sf-doctools sonic-namespace"
makedepends="sf-archive-devel sf-core-addons-devel sf-doctools-devel sf-internationalization-devel"
short_desc="Installation and loading of additional content as packages"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-package"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-package/archive/refs/tags/${version}.tar.gz"
checksum=68d743017437d901f50f873cfe770f512e96584cf5664647e1f79c8823358616

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# flaky on CI: createAndUpdatePackage fails removing leftover package dir
	ctest -E "plasmoidpackagetest"
}

sf-package-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
