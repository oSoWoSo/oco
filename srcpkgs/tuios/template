# Template file for 'tuios'
pkgname=tuios
version=0.12.0
revision=1
build_style=go
build_helper=qemu
go_import_path="github.com/Gaurav-Gosain/tuios"
go_package="./cmd/tuios"
hostmakedepends="git"
short_desc="Terminal UI OS (Terminal Multiplexer)"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/Gaurav-Gosain/tuios"
distfiles="https://github.com/Gaurav-Gosain/tuios/archive/refs/tags/v${version}.tar.gz"
checksum=2d1e177e5e6c500acd1a2833cc28677bd659f036bb15f96a869fb1cc13770140

post_install() {
	vlicense LICENSE
	f=$(find "$GOPATH/bin" -name $pkgname)
	for shell in bash fish zsh; do
		vtargetrun "$f" completion "$shell" > "completion.$shell"
		vcompletion "completion.$shell" "$shell"
	done
}
